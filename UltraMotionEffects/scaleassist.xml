<?xml version='1.0' encoding='utf-8'?>
<effect id="com.alightcreative.effects.scaleassist" name="@am:string/effect_scaleassist_name" desc="@am:string/effect_scaleassist_desc" category="movetransform" tags="transform,propAdjust,parenting" thumb="thumb/5/hardg.png">

    <params>
        <menu id="axis" default="3" style="radio" label="@am:string/effect_param_axis">
            <menu label="X" value="0" />
            <menu label="Y" value="1" />
            <menu label="X,Y" value="2" enableTargets="damp" />
            <menu label="X,-Y" value="3" enableTargets="damp" />
        </menu>
        <slider id="scale" default="1.0" min="0.0" max="1000.0" step="0.001" label="@am:string/effect_param_scale" type="percent" ticks="0.5,1.0,1.5,2.0" />
        <slider id="damp" default="1.0" min="0.0" max="1000.0" step="0.01" label="@am:string/effect_param_damping" type="percent" ticks="0.5,1.0,1.5,2.0" enabled="false" />
    </params>

    

</effect>