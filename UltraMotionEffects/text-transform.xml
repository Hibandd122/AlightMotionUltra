<?xml version='1.0' encoding='utf-8'?>
<effect id="com.alightcreative.effects.texttransform" name="@am:string/effect_texttransform_name" desc="@am:string/effect_texttransform_desc" affinity="text!" type="text" category="text" tags="text,kinetic,membersOnly" thumb="thumb/text_transform.webp">

    
        
            
            
        
    

    <params>

        
        <slider id="start" default="0.0" min="0.0" max="1.0" type="percent" step="0.001" label="@am:string/effect_param_start" ticks="0.0,0.5,1.0" />
        <slider id="end" default="1.0" min="0.0" max="1.0" type="percent" step="0.001" label="@am:string/effect_param_end" ticks="0.0,0.5,1.0" />
        <slider id="phase" default="0.0" min="-1.0" max="2.0" type="percent" step="0.001" label="@am:string/effect_param_phase" ticks="-1.0,0.0,1.0" />

        
        <menu id="component" default="1" style="dropdown" label="@am:string/effect_param_component">
            <menu label="@am:string/effect_param_component_contour" value="0" />
            <menu label="@am:string/effect_param_component_letter" value="1" />
            <menu label="@am:string/effect_param_component_word" value="2" />
            <menu label="@am:string/effect_param_component_line" value="3" />
        </menu>
        <menu id="anchor" default="0" style="radio" label="@am:string/effect_param_anchor">
            <menu label="@am:string/effect_param_layer" value="0" />
            <menu label="@am:string/effect_param_component" value="1" />
        </menu>
        <point id="offset" default="0.0,0.0" label="@am:string/effect_param_offset" />
        <slider id="angle" default="0.0" min="-1800.0" max="1800.0" label="@am:string/effect_param_angle" ticks="-90,-45,0,45,90" snap="-90,-45,0,45,90" type="angle" step="0.1" />
        <slider id="scale" default="0.0" min="-1.0" max="10.0" label="@am:string/effect_param_scale" ticks="0.0" snap="-90,-45,0,45,90" step="0.01" />
        <slider id="stretch" default="0.0" min="-1.0" max="10.0" label="@am:string/effect_param_stretch" ticks="0.0" snap="-90,-45,0,45,90" step="0.01" />
        <slider id="alpha" default="0" min="-1" max="1" step="0.001" label="@am:string/effect_param_alpha" ticks="0.0" />

        
        <switch id="useFillColor" default="false" label="@am:string/effect_param_override_fill_color" />
        <color id="fillColor" default="#FF00FF00" label="@am:string/effect_param_fillColor" alpha="false" />

        
        <slider id="easeIn" default="0" min="-1" max="1" label="@am:string/effect_param_ease_in" step="0.01" type="percent" snap="0" ticks="0" />
        <slider id="easeOut" default="0" min="-1" max="1" label="@am:string/effect_param_ease_out" step="0.01" type="percent" snap="0" ticks="0" />
        <slider id="overlap" default="0" min="0" max="10" label="@am:string/effect_param_overlap" step="0.01" type="percent" />
        <menu id="shape" default="0" style="radio" label="@am:string/effect_param_shape">
            <menu label="@am:string/effect_param_square" value="0" />
            <menu label="@am:string/effect_param_smooth" value="1" />
            <menu label="@am:string/effect_param_triangle" value="2" />
        </menu>

        
        <switch id="randomOrder" default="false" label="@am:string/effect_param_random_order" />
        <slider id="seed" default="0.0" min="0.0" max="5.0" step="0.01" label="@am:string/effect_param_seed" />

    </params>

</effect>