<?xml version='1.0' encoding='utf-8'?>
<effect id="com.alightcreative.effects.shake" name="@am:string/effect_shake_name" desc="@am:string/effect_shake_desc" auto-transform="true" category="movetransform" tags="transform,auto,shake,propAdjust" deprecated="true" thumb="thumb/shake.webp">

    <params>
        <slider id="mag" min="0" max="2000" step="1" default="50" label="@am:string/effect_param_mag" />
        <slider id="speed" min="0" max="2000" step="0.01" default="1" label="@am:string/effect_param_speed" />
        <slider id="evolution" min="0" max="2000" step="0.01" default="0" label="@am:string/effect_param_evolution" />
        <slider id="seed" min="0" max="5" step="0.01" default="0" label="@am:string/effect_param_seed" />
        <slider id="angle" default="45.0" min="0.0" max="3600.0" label="@am:string/effect_param_angle" type="angle" step="0.5" ticks="0,45,90,135,180,225,270,315,360" snap="45,90,135" />
        <slider id="slack" min="0" max="1" step="0.01" default="0.25" label="@am:string/effect_param_slack" type="percent" />

    </params>

    

</effect>