<?xml version='1.0' encoding='utf-8'?>
<effect category_ultra="Grids & Tunnels" id="com.alightcreative.effects.repeat.radial" name="@am:string/effect_repeatradial_name" desc="@am:string/effect_repeatradial_desc" category="repeat" tags="repeat" thumb="thumb/5/hardg.png">

    
        
            
            
        
    

    <params>
        <slider id="count" default="8" min="0" max="150" step="1" label="@am:string/effect_param_count" />
        <slider id="radius" default="300" min="0" max="2000" step="1" label="@am:string/effect_param_radius" />
        <slider id="orientation" default="0.0" min="-1800.0" max="1800.0" label="@am:string/effect_param_orientation" ticks="-90,-45,0,45,90" snap="-90,-45,0,45,90" type="angle" step="1" />
        <slider id="startAngle" default="0.0" min="-36000.0" max="36000.0" label="@am:string/effect_param_angle" ticks="0,45,90,180,270,360" type="angle" step="1" />
        <slider id="sweep" default="360.0" min="0.0" max="360.0" label="@am:string/effect_param_sweep" ticks="0,45,90,180,270,360" type="angle" step="1" />
        <slider id="baseScale" default="1.0" min="0" max="10.0" label="@am:string/effect_param_scale" ticks="0.25,0.5,0.75,1,2" step="0.01" />
        
        <point id="offset" default="0.0,0.0" label="@am:string/effect_param_offset" />
        <slider id="angle" default="0.0" min="-1800.0" max="1800.0" label="@am:string/effect_param_angle" ticks="-90,-45,0,45,90" type="angle" step="1" />
        <slider id="scale" default="1.0" min="0" max="10.0" label="@am:string/effect_param_scale" ticks="0.25,0.5,0.75,1,2" step="0.01" />
        <slider id="alpha" default="1" min="0" max="1" step="0.001" label="@am:string/effect_param_alpha" />
        
        <color id="fillColor" default="#FF2D1EF6" label="@am:string/effect_param_color" alpha="false" />
        <slider id="blend" default="0.00" min="0.0" max="2" ticks="1" snap="1" label="@am:string/effect_param_blend" />
        <switch id="colorAltCopies" default="false" label="@am:string/effect_param_altCopies" />

        
        <slider id="start" default="0.0" min="0.0" max="1.0" type="percent" step="0.001" label="@am:string/effect_param_start" ticks="0.0,0.5,1.0" />
        <slider id="end" default="1.0" min="0.0" max="1.0" type="percent" step="0.001" label="@am:string/effect_param_end" ticks="0.0,0.5,1.0" />
        <slider id="phase" default="0.0" min="-1.0" max="2.0" type="percent" step="0.001" label="@am:string/effect_param_phase" ticks="-1.0,0.0,1.0" />

        
        <slider id="easeIn" default="0" min="-1" max="1" label="@am:string/effect_param_ease_in" step="0.01" type="percent" snap="0" ticks="0" />
        <slider id="easeOut" default="0" min="-1" max="1" label="@am:string/effect_param_ease_out" step="0.01" type="percent" snap="0" ticks="0" />
        <slider id="overlap" default="0" min="0" max="10" label="@am:string/effect_param_overlap" step="0.01" type="percent" />
        <menu id="shape" default="0" style="radio" label="@am:string/effect_param_shape">
            <menu label="@am:string/effect_param_ramp" value="0" />
            <menu label="@am:string/effect_param_square" value="1" />
            <menu label="@am:string/effect_param_smooth" value="2" />
            <menu label="@am:string/effect_param_triangle" value="3" />
        </menu>
        <switch id="invert" default="false" label="@am:string/effect_param_invert" />

        
        <switch id="randomOrder" default="false" label="@am:string/effect_param_random_order" />
        <slider id="seed" default="0.0" min="0.0" max="5.0" step="0.01" label="@am:string/effect_param_seed" />

        
        
    </params>

</effect>